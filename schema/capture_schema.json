{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cozmo AI Capture Output",
  "type": "object",
  "required": ["capture_id", "tier", "generated_at", "rooms", "stitched_plan", "confidence_note"],
  "properties": {
    "capture_id": {"type": "string"},
    "tier": {"type": "string", "enum": ["photo", "video", "lidar"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "pipeline_version": {"type": "string"},
    "confidence_note": {
      "type": "string",
      "description": "Human-readable statement of how intervals were derived for this run."
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["room_id", "ceiling_height_m", "floor_area_m2", "walls", "damage_regions", "confidence"],
        "properties": {
          "room_id": {"type": "string"},
          "ceiling_height_m": {"$ref": "#/definitions/measurement"},
          "floor_area_m2": {"$ref": "#/definitions/measurement"},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "walls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["wall_id", "length_m", "p0", "p1", "openings", "trusted"],
              "properties": {
                "wall_id": {"type": "string"},
                "length_m": {"$ref": "#/definitions/measurement"},
                "p0": {"$ref": "#/definitions/point2d"},
                "p1": {"$ref": "#/definitions/point2d"},
                "trusted": {"type": "boolean"},
                "openings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["opening_id", "start_frac", "end_frac", "width_m"],
                    "properties": {
                      "opening_id": {"type": "string"},
                      "start_frac": {"type": "number"},
                      "end_frac": {"type": "number"},
                      "width_m": {"$ref": "#/definitions/measurement"}
                    }
                  }
                }
              }
            }
          },
          "damage_regions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["region_id", "surface_wall_id", "damage_class", "extent_m2", "concealed_flag"],
              "properties": {
                "region_id": {"type": "string"},
                "surface_wall_id": {"type": "string"},
                "damage_class": {"type": "string"},
                "extent_m2": {"$ref": "#/definitions/measurement"},
                "concealed_flag": {
                  "type": "object",
                  "required": ["flagged", "rule"],
                  "properties": {
                    "flagged": {"type": "boolean"},
                    "rule": {"type": "string"}
                  }
                }
              }
            }
          },
          "scope_line_items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["item", "surface_wall_id", "quantity", "unit"],
              "properties": {
                "item": {"type": "string"},
                "surface_wall_id": {"type": "string"},
                "quantity": {"type": "number"},
                "unit": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "stitched_plan": {
      "type": "object",
      "required": ["rooms_placed", "adjacency", "footprint_m2", "render_path"],
      "properties": {
        "rooms_placed": {"type": "array", "items": {"type": "string"}},
        "adjacency": {
          "type": "array",
          "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}
        },
        "footprint_m2": {"$ref": "#/definitions/measurement"},
        "render_path": {"type": "string"}
      }
    }
  },
  "definitions": {
    "point2d": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "measurement": {
      "type": "object",
      "required": ["value", "unit", "ci_low", "ci_high", "basis"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string"},
        "ci_low": {"type": "number"},
        "ci_high": {"type": "number"},
        "basis": {"type": "string"}
      }
    }
  }
}
